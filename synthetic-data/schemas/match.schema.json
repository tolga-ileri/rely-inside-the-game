{
  "$defs": {
    "Event": {
      "additionalProperties": false,
      "description": "One on-ball or off-ball football event. Coordinates: 0-100, acting team's attacking frame.",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "period": {
          "maximum": 2,
          "minimum": 1,
          "title": "Period",
          "type": "integer"
        },
        "match_second": {
          "minimum": 0,
          "title": "Match Second",
          "type": "integer"
        },
        "minute": {
          "minimum": 0,
          "title": "Minute",
          "type": "integer"
        },
        "second": {
          "maximum": 59,
          "minimum": 0,
          "title": "Second",
          "type": "integer"
        },
        "team_id": {
          "title": "Team Id",
          "type": "string"
        },
        "player_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Id"
        },
        "event_type": {
          "enum": [
            "Pass",
            "Carry",
            "Shot",
            "Goal",
            "Ball Recovery",
            "Interception",
            "Tackle",
            "Pressure",
            "Duel",
            "Foul",
            "Card",
            "Substitution",
            "Clearance",
            "Cross",
            "Dribble",
            "Goalkeeper Action",
            "Possession Change",
            "Restart"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "start_x": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Start X",
          "type": "number"
        },
        "start_y": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Start Y",
          "type": "number"
        },
        "end_x": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End X"
        },
        "end_y": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Y"
        },
        "possession_id": {
          "title": "Possession Id",
          "type": "integer"
        },
        "sequence_id": {
          "title": "Sequence Id",
          "type": "integer"
        },
        "qualifiers": {
          "title": "Qualifiers",
          "type": "object"
        },
        "metadata": {
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "event_id",
        "match_id",
        "period",
        "match_second",
        "minute",
        "second",
        "team_id",
        "event_type",
        "start_x",
        "start_y",
        "possession_id",
        "sequence_id"
      ],
      "title": "Event",
      "type": "object"
    },
    "Player": {
      "properties": {
        "player_id": {
          "title": "Player Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "position": {
          "title": "Position",
          "type": "string"
        },
        "starter": {
          "title": "Starter",
          "type": "boolean"
        }
      },
      "required": [
        "player_id",
        "name",
        "number",
        "position",
        "starter"
      ],
      "title": "Player",
      "type": "object"
    },
    "Team": {
      "properties": {
        "side": {
          "enum": [
            "home",
            "away"
          ],
          "title": "Side",
          "type": "string"
        },
        "team_id": {
          "title": "Team Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "short": {
          "title": "Short",
          "type": "string"
        },
        "color": {
          "title": "Color",
          "type": "string"
        },
        "crest": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Crest",
          "type": "object"
        },
        "players": {
          "items": {
            "$ref": "#/$defs/Player"
          },
          "title": "Players",
          "type": "array"
        }
      },
      "required": [
        "side",
        "team_id",
        "name",
        "short",
        "color",
        "crest",
        "players"
      ],
      "title": "Team",
      "type": "object"
    }
  },
  "properties": {
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "scenario": {
      "title": "Scenario",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "synthetic": {
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "data_statement": {
      "title": "Data Statement",
      "type": "string"
    },
    "duration_seconds": {
      "title": "Duration Seconds",
      "type": "integer"
    },
    "demo": {
      "title": "Demo",
      "type": "object"
    },
    "home_team_id": {
      "title": "Home Team Id",
      "type": "string"
    },
    "away_team_id": {
      "title": "Away Team Id",
      "type": "string"
    },
    "teams": {
      "items": {
        "$ref": "#/$defs/Team"
      },
      "title": "Teams",
      "type": "array"
    },
    "event_count": {
      "title": "Event Count",
      "type": "integer"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "match_id",
    "scenario",
    "title",
    "data_statement",
    "duration_seconds",
    "home_team_id",
    "away_team_id",
    "teams",
    "event_count",
    "events"
  ],
  "title": "Match",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
