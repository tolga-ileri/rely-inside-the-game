# Copy to .env and fill in locally. Never commit .env.
# AI provider: "none" (deterministic templates, default, no network) or "microsoft_foundry"
AI_PROVIDER=none
# Azure AI Foundry (model inference endpoint), only used when AI_PROVIDER=microsoft_foundry
FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/models
FOUNDRY_API_KEY=
FOUNDRY_MODEL=gpt-4o-mini
FOUNDRY_TIMEOUT_SECONDS=12
# Paths / ports
RELY_MATCHES_DIR=../../synthetic-data/matches
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
# Web
NEXT_PUBLIC_API_URL=http://127.0.0.1:8100
